{
  "name": "saucerswap-limit-orders",
  "description": "Keeperless limit and stop-loss orders on SaucerSwap V2, guarded by Chainlink and executed by the Hedera Schedule Service.",
  "version": "0.0.1",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": [
        "nextjs-app"
      ],
      "solidityFramework": [
        "foundry"
      ],
      "packageManager": [
        "yarn",
        "npm"
      ]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Start a local chain",
              "command": "{run:framework:chain}"
            },
            {
              "label": "Deploy contracts to that node",
              "command": "{run:framework:deploy} --network localhost"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "text": "README.md covers testnet setup, environment variables and architecture."
            }
          ]
        }
      ]
    }
  }
}
