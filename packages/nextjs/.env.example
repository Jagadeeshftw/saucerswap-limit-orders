# WalletConnect Cloud project id; the scaffold's shared default works for local development.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Hedera testnet JSON-RPC relay (default https://testnet.hashio.io/api).
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
# Hedera testnet mirror node (default https://testnet.mirrornode.hedera.com).
NEXT_PUBLIC_MIRROR_NODE_URL=
