# Foundry environment. `yarn install` copies this file to .env (gitignored).
# Deploys sign with a Foundry keystore (`yarn foundry:account:import`), so no private key goes here.

# Hedera JSON-RPC relay used by `yarn foundry:test:testnet` and `yarn foundry:fork` (default https://testnet.hashio.io/api).
HEDERA_RPC_URL=https://testnet.hashio.io/api
